---
import '../styles/global.css';
import baseThemeCss from '../themes/base.css?raw';
import PrototypePilotConsent from '../components/PrototypePilotConsent.astro';
import { prototypePilotPolicyUrl } from '../lib/prototypePilotPolicy';
import { trailblazerFormPath } from '../lib/site';

const user = Astro.locals.user;
const requestedNextPath = Astro.url.searchParams.get('next') ?? trailblazerFormPath;
const nextPath = requestedNextPath.startsWith('/') && !requestedNextPath.startsWith('//')
  ? requestedNextPath
  : trailblazerFormPath;

if (user) {
  return Astro.redirect(nextPath);
}

const error = Astro.url.searchParams.get('error') ?? '';
const errorDescription = Astro.url.searchParams.get('error_description') ?? '';

function getErrorMessage(code: string, description: string) {
  if (code === 'config') return 'Trailblazer authentication is not configured yet.';
  if (code === 'callback') {
    return 'The sign-in code could not be completed. Request a fresh security code and use the newest email only once.';
  }
  if (description) return description;
  return '';
}

const message = getErrorMessage(error, errorDescription);
const securityCodeLength = 6;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Trailblazer | Sign in</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/images/favicon/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/images/favicon/manifest.json" />
    <meta name="msapplication-TileImage" content="/images/favicon/ms-icon-144x144.png" />
    <style is:inline set:html={baseThemeCss}></style>
    <style is:inline>
      :root {
        color-scheme: light;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #fff;
      }

      body {
        font-family: var(--font-body, sans-serif);
        background: #3a3a3a;
      }

      .access-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 20px;
        background: #3a3a3a;
        position: relative;
      }

      .access-stage {
        width: 100%;
        min-height: calc(100vh - 40px);
        display: grid;
        place-items: center;
        padding-bottom: 46px;
      }

      .access-frame {
        width: min(100%, 1000px);
        display: grid;
        grid-template-columns: minmax(360px, 430px) minmax(500px, 570px);
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 26px 88px rgba(0, 0, 0, 0.22);
      }

      .access-card {
        padding: 64px 64px 48px;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        min-height: 552px;
      }

      .access-mark {
        width: 330px;
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto 42px;
      }

      .visual-panel {
        position: relative;
        min-height: 552px;
        background:
          linear-gradient(180deg, rgba(255, 19, 52, 0.1), rgba(15, 23, 42, 0.08)),
          url("/images/reg-bg-04.webp") center / cover no-repeat;
        overflow: hidden;
      }

      .access-label {
        display: none;
      }

      .access-title {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
      }

      .access-form {
        width: 302px;
        max-width: 100%;
        margin-top: 0;
        display: grid;
        gap: 14px;
      }

      .access-field {
        display: grid;
        gap: 6px;
        font-size: 0.82rem;
        font-weight: 400;
        color: #3f3f46;
      }

      .access-input {
        width: 100%;
        border-radius: 8px;
        border: 1px solid rgba(203, 213, 225, 0.9);
        background: #fff;
        padding: 9px 11px;
        font: inherit;
        font-size: 0.94rem;
        color: #0f172a;
        outline: none;
        box-shadow: inset 0 2px 8px rgba(15, 23, 42, 0.08);
      }

      .access-input:focus {
        border-color: #ff1334;
        box-shadow:
          inset 0 2px 8px rgba(15, 23, 42, 0.08),
          0 0 0 3px rgba(255, 19, 52, 0.12);
      }

      .access-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 12px;
      }

      .access-actions[hidden] {
        display: none;
      }

      .access-step {
        display: grid;
        gap: 14px;
      }

      .access-step.is-code-entry {
        justify-items: center;
        gap: 12px;
        text-align: center;
      }

      .access-step[hidden] {
        display: none;
      }

      .access-button {
        width: 100%;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 0.92rem;
        font-weight: 700;
        border: 0;
        background: #ff1334;
        color: #fff;
        cursor: pointer;
      }

      .access-button:disabled {
        cursor: not-allowed;
        opacity: 0.65;
      }

      .access-secondary-button {
        width: 100%;
        border-radius: 8px;
        border: 0;
        background: transparent;
        color: #6c56ff;
        cursor: pointer;
        padding: 0;
        font: inherit;
        font-size: 0.88rem;
        font-weight: 700;
      }

      .access-code-title {
        margin: 0;
        color: #1f2937;
        font-size: 1.06rem;
        font-weight: 800;
        line-height: 1.2;
      }

      .access-code-subtitle,
      .access-code-email {
        margin: 0;
        color: #6b7280;
        font-size: 0.92rem;
        line-height: 1.35;
      }

      .access-code-email {
        display: inline-flex;
        max-width: 100%;
        align-items: center;
        justify-content: center;
        gap: 8px;
        overflow-wrap: anywhere;
      }

      .access-edit-email {
        border: 0;
        background: transparent;
        color: #6c56ff;
        cursor: pointer;
        padding: 2px;
        line-height: 1;
      }

      .access-edit-email svg {
        width: 15px;
        height: 15px;
        display: block;
      }

      .access-code-grid {
        display: grid;
        width: 100%;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 7px;
        margin-top: 20px;
      }

      .access-code-box {
        width: 100%;
        aspect-ratio: 1 / 1;
        border: 1px solid rgba(255, 19, 52, 0.52);
        border-radius: 7px;
        background: #fff;
        color: #111827;
        font: inherit;
        font-size: 1.12rem;
        font-weight: 800;
        text-align: center;
        outline: none;
        box-shadow: none;
      }

      .access-code-box:focus {
        border-color: #6c56ff;
        box-shadow: 0 0 0 3px rgba(108, 86, 255, 0.18);
      }

      .access-resend-button {
        border: 0;
        background: transparent;
        color: #b89aff;
        cursor: pointer;
        padding: 0;
        font: inherit;
        font-size: 0.82rem;
        font-weight: 700;
      }

      .access-resend-button:disabled {
        cursor: not-allowed;
        opacity: 0.72;
      }

      .access-code-footer {
        width: calc(100% + 128px);
        margin: 20px -64px -48px;
        border-top: 1px solid rgba(17, 24, 39, 0.1);
        background: #f9fafb;
        padding: 16px 20px;
        color: #6b7280;
        font-size: 0.76rem;
        font-weight: 700;
        text-align: center;
      }

      .access-status {
        display: none;
        border-radius: 8px;
        border: 1px solid transparent;
        padding: 10px 12px;
        font-size: 0.82rem;
        line-height: 1.45;
      }

      .access-status.is-visible {
        display: block;
      }

      .access-status.is-success {
        border-color: #a7f3d0;
        background: #ecfdf5;
        color: #166534;
      }

      .access-status.is-error {
        border-color: transparent;
        background: transparent;
        color: #ff1334;
        padding: 0;
        text-align: center;
      }

      .access-footnote {
        width: 302px;
        max-width: 100%;
        margin: 14px 0 0;
        font-size: 0.76rem;
        color: #6b7280;
        line-height: 1.45;
        text-align: center;
      }

      .access-footnote strong {
        color: #111827;
      }

      .login-footer {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        width: calc(100% - 40px);
        text-align: center;
        color: rgba(255, 255, 255, 0.86);
        font-size: 0.72rem;
        line-height: 1.7;
      }

      .login-footer a {
        color: inherit;
      }

      @media (max-width: 900px) {
        .access-frame {
          grid-template-columns: 1fr;
          width: min(100%, 620px);
        }

        .visual-panel {
          min-height: 340px;
          order: -1;
        }

        .access-card {
          min-height: auto;
          padding: 42px 28px 34px;
        }

        .access-code-footer {
          width: calc(100% + 56px);
          margin: 20px -28px -34px;
        }
      }

      @media (max-width: 560px) {
        .access-shell {
          padding: 14px;
        }

        .access-stage {
          min-height: calc(100vh - 28px);
        }

        .access-card {
          padding: 28px 18px 22px;
        }

        .access-code-footer {
          width: calc(100% + 36px);
          margin: 20px -18px -22px;
        }

        .visual-panel {
          min-height: 240px;
        }
      }
    </style>
  </head>
  <body>
    <main class="access-shell">
      <section class="access-stage">
        <div class="access-frame">
          <section class="access-card">
            <div class="access-label">Magic link access</div>
            <img
              class="access-mark"
              src="/images/magikit-trailblazer-banner-login.svg"
              width="653"
              height="197"
              alt="Disney MagiKit Trailblazer"
            />
            <h1 class="access-title">Secure sign-in code</h1>

            <form id="embedded-form-access" class="access-form">
              <div class="access-step" data-email-step>
                <label class="access-field">
                  Email address:
                  <input
                    id="embedded-form-email"
                    type="email"
                    name="email"
                    autocomplete="email"
                    required
                    placeholder="name@company.com"
                    class="access-input"
                  />
                </label>

                <PrototypePilotConsent />
              </div>

              <div class="access-step is-code-entry" data-code-step hidden>
                <p class="access-code-title">Check your email</p>
                <p class="access-code-subtitle">to continue to Trailblazer</p>
                <p class="access-code-email">
                  <span data-code-email></span>
                  <button class="access-edit-email" type="button" data-use-another-email aria-label="Edit email address">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 20h4.6L19.2 9.4a2.1 2.1 0 0 0 0-3L17.6 4.8a2.1 2.1 0 0 0-3 0L4 15.4V20Zm2-2v-1.8l10-10 1.8 1.8-10 10H6Zm10.9-11.2.9-.9.3.3-.9.9-.3-.3Z" fill="currentColor"></path>
                    </svg>
                  </button>
                </p>
                <div class="access-code-grid" aria-label="Six-digit security code">
                  {Array.from({ length: securityCodeLength }, (_, index) => (
                    <input
                      class="access-code-box"
                      type="text"
                      inputmode="numeric"
                      pattern="[0-9]*"
                      maxlength="1"
                      autocomplete={index === 0 ? 'one-time-code' : 'off'}
                      aria-label={`Digit ${index + 1} of six-digit security code`}
                      data-code-input
                    />
                  ))}
                </div>
                <button class="access-resend-button" type="button" data-resend-code>
                  Didn't receive a code? Resend <span data-resend-countdown></span>
                </button>
                <div class="access-actions">
                  <button
                    id="embedded-form-submit"
                    type="submit"
                    class="access-button"
                  >
                    Continue <span aria-hidden="true">›</span>
                  </button>
                </div>
                <div class="access-code-footer">
                  Secured by Advanced Analytica
                </div>
              </div>

              <div class="access-actions" data-email-actions>
                <button
                  id="embedded-form-send"
                  type="submit"
                  class="access-button"
                >
                  Send security code
                </button>
              </div>

              <p id="embedded-form-status" class={`access-status${message ? ' is-visible is-error' : ''}`}>{message}</p>
            </form>

            <p class="access-footnote">
              Use the newest security code only once.
            </p>
          </section>

          <aside class="visual-panel" aria-hidden="true"></aside>
        </div>

        <div class="login-footer">
          <a href={prototypePilotPolicyUrl}>Terms of use</a>
          &nbsp;&nbsp; <a href="https://advancedanalytica.co.uk/legal/privacy">Privacy policy</a>
          &nbsp;&nbsp; © Disney
        </div>
      </section>
    </main>

    <script is:inline define:vars={{ nextPath, securityCodeLength }}>
      const form = document.getElementById('embedded-form-access');
      const emailInput = document.getElementById('embedded-form-email');
      const sendButton = document.getElementById('embedded-form-send');
      const continueButton = document.getElementById('embedded-form-submit');
      const status = document.getElementById('embedded-form-status');
      const emailStep = document.querySelector('[data-email-step]');
      const codeStep = document.querySelector('[data-code-step]');
      const emailActions = document.querySelector('[data-email-actions]');
      const codeEmail = document.querySelector('[data-code-email]');
      const codeInputs = Array.from(document.querySelectorAll('[data-code-input]'));
      const useAnotherEmailButton = document.querySelector('[data-use-another-email]');
      const resendButton = document.querySelector('[data-resend-code]');
      const resendCountdown = document.querySelector('[data-resend-countdown]');
      const consentInput = document.querySelector('[data-prototype-pilot-consent]');
      const policyUrlInput = document.querySelector('[data-prototype-pilot-policy-url]');
      const policyVersionInput = document.querySelector('[data-prototype-pilot-policy-version]');
      const engagementInput = document.querySelector('[data-prototype-pilot-engagement]');
      const resendSeconds = 60;
      let resendTimer = 0;
      let remainingResendSeconds = resendSeconds;
      let pendingEmail = '';
      let isCodeStep = false;

      if (
        form instanceof HTMLFormElement &&
        emailInput instanceof HTMLInputElement &&
        sendButton instanceof HTMLButtonElement &&
        continueButton instanceof HTMLButtonElement &&
        status instanceof HTMLElement &&
        emailStep instanceof HTMLElement &&
        codeStep instanceof HTMLElement &&
        emailActions instanceof HTMLElement &&
        codeEmail instanceof HTMLElement &&
        codeInputs.every((input) => input instanceof HTMLInputElement) &&
        useAnotherEmailButton instanceof HTMLButtonElement &&
        resendButton instanceof HTMLButtonElement &&
        resendCountdown instanceof HTMLElement &&
        consentInput instanceof HTMLInputElement &&
        policyUrlInput instanceof HTMLInputElement &&
        policyVersionInput instanceof HTMLInputElement &&
        engagementInput instanceof HTMLInputElement
      ) {
        const setStatus = (message, tone) => {
          status.textContent = message;
          status.classList.remove('is-success', 'is-error');
          status.classList.add('is-visible', tone === 'success' ? 'is-success' : 'is-error');
        };

        const clearStatus = () => {
          status.classList.remove('is-visible', 'is-success', 'is-error');
          status.textContent = '';
        };

        const getCode = () => codeInputs.map((input) => input.value).join('');

        const fillCode = (value) => {
          const digits = value.replace(/\D/g, '').slice(0, securityCodeLength);
          codeInputs.forEach((input, index) => {
            input.value = digits[index] || '';
          });
          const nextIndex = Math.min(digits.length, securityCodeLength - 1);
          codeInputs[nextIndex]?.focus();
        };

        const updateResendLabel = () => {
          resendCountdown.textContent = remainingResendSeconds > 0 ? `(${remainingResendSeconds})` : '';
          resendButton.disabled = remainingResendSeconds > 0;
        };

        const startResendTimer = () => {
          window.clearInterval(resendTimer);
          remainingResendSeconds = resendSeconds;
          updateResendLabel();
          resendTimer = window.setInterval(() => {
            remainingResendSeconds = Math.max(0, remainingResendSeconds - 1);
            updateResendLabel();
            if (remainingResendSeconds === 0) window.clearInterval(resendTimer);
          }, 1000);
        };

        const setStep = (step) => {
          isCodeStep = step === 'code';
          emailStep.hidden = isCodeStep;
          codeStep.hidden = !isCodeStep;
          emailActions.hidden = isCodeStep;
          if (isCodeStep) {
            codeEmail.textContent = pendingEmail;
            codeInputs.forEach((input) => {
              input.required = true;
              input.value = '';
            });
            codeInputs[0]?.focus();
            startResendTimer();
          } else {
            codeInputs.forEach((input) => {
              input.required = false;
              input.value = '';
            });
            window.clearInterval(resendTimer);
            pendingEmail = '';
            emailInput.focus();
          }
        };

        const returnToEmailStep = () => {
          clearStatus();
          setStep('email');
        };

        useAnotherEmailButton.addEventListener('click', returnToEmailStep);

        codeInputs.forEach((input, index) => {
          input.addEventListener('input', () => {
            const digits = input.value.replace(/\D/g, '');
            if (digits.length > 1) {
              fillCode(digits);
              return;
            }

            input.value = digits;
            if (digits && index < codeInputs.length - 1) codeInputs[index + 1]?.focus();
          });

          input.addEventListener('keydown', (event) => {
            if (event.key === 'Backspace' && !input.value && index > 0) codeInputs[index - 1]?.focus();
          });

          input.addEventListener('paste', (event) => {
            event.preventDefault();
            fillCode(event.clipboardData?.getData('text') || '');
          });
        });

        const sendSecurityCode = async (email) => {
          const response = await fetch('/auth/secure-code', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              email,
              nextUrl: nextPath,
              prototypePilotConsentAccepted: consentInput.checked,
              prototypePilotPolicyUrl: policyUrlInput.value,
              prototypePilotPolicyVersion: policyVersionInput.value,
              prototypePilotEngagement: engagementInput.value,
            }),
          });

          const payload = await response.json().catch(() => null);
          if (!response.ok) throw new Error(payload?.error || 'Failed to send security code.');
          return payload;
        };

        resendButton.addEventListener('click', async () => {
          if (!pendingEmail || remainingResendSeconds > 0) return;
          resendButton.disabled = true;
          try {
            await sendSecurityCode(pendingEmail);
            setStatus('We sent a fresh security code.', 'success');
            startResendTimer();
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Failed to send security code.';
            setStatus(message, 'error');
            updateResendLabel();
          }
        });

        form.addEventListener('submit', async (event) => {
          event.preventDefault();

          const email = emailInput.value.trim();

          if (!isCodeStep) {
            if (!email) {
              setStatus('Enter a work email address.', 'error');
              return;
            }

            if (!consentInput.checked) {
              setStatus('Please acknowledge the prototype and pilot terms before we send the security code.', 'error');
              consentInput.focus();
              return;
            }
          }

          sendButton.disabled = true;
          continueButton.disabled = true;
          sendButton.textContent = 'Sending...';
          continueButton.textContent = 'Working...';
          clearStatus();

          try {
            const response = isCodeStep ? await fetch('/auth/verify-code', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                email: pendingEmail,
                code: getCode(),
                nextUrl: nextPath,
              }),
            }) : null;

            if (!isCodeStep) {
              await sendSecurityCode(email);
              pendingEmail = email.toLowerCase();
              setStep('code');
              return;
            }

            const payload = await response?.json().catch(() => null);

            if (!response?.ok) {
              throw new Error(payload?.error || 'Failed to verify security code.');
            }

            window.location.assign(payload?.nextUrl || nextPath);
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Failed to send security code.';
            setStatus(message, 'error');
          } finally {
            sendButton.disabled = false;
            continueButton.disabled = false;
            sendButton.textContent = 'Send security code';
            continueButton.innerHTML = 'Continue <span aria-hidden="true">›</span>';
          }
        });
      }
    </script>
  </body>
</html>
